import java.util.*;
public class Main
{
    public static void main(String []args)
    {
        //Hollow Rectangle
        int rows;
        int cols;
        System.out.println("Give rows ");
        Scanner sc=new Scanner(System.in);
        rows=sc.nextInt();
        System.out.println("Give Cols ");
        cols=sc.nextInt();
        for(int i=0;i<rows;i++)
        {
            for(int j=0;j<cols;j++)
            {
                if(i==0 || i==rows-1 || j==0 || j==cols-1) {
                    System.out.print("*");
                } else
                    System.out.print(" ");
            }
            System.out.println("");
        }
    }
}
