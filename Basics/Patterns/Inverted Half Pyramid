import java.util.*;
public class Main
{
    public static void main(String []args)
    {
        //Inverted half pyramid
        int n;
        Scanner sc=new Scanner(System.in);
        System.out.println("Enter n");
        n=sc.nextInt();
        for(int i=1;i<=n;i++)
        {
            for(int j=1;j<=n-i+1;j++)
            {
                System.out.print("*");
            }
            System.out.println("");
        }

    }
}
