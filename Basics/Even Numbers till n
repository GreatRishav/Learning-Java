import java.util.*;
public class Main
{
    public static void main(String []args)
    {
        int n;
        System.out.println("Give n ");
        Scanner sc=new Scanner(System.in);
        n=sc.nextInt();
        for(int i=1;i<n;i++)
        {
            if(i%2==0)
            {
                System.out.println(i);
            }
        }
    }
}
